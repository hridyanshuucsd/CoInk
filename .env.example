# Required for AI tutoring and realtime voice.
OPENAI_API_KEY=sk-...

# Access gate. When set, every page and API call requires this code.
# Visitors enter it once at /?code=NNNNNN and receive an HttpOnly cookie.
# Leave empty to disable the gate (only safe on a trusted local network).
ACCESS_CODE=

# Canvas / vision tutor model, used for the silent auto-tutor and the
# no-voice fallback. Terra is a good quality/latency default.
OPENAI_TUTOR_MODEL=gpt-5.6-terra
OPENAI_TUTOR_REASONING=medium

# Realtime voice model and voice.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Turn-taking sensitivity for semantic VAD: low | auto | high.
# 'high' replies fast but can cut into a thinking pause; 'low' is patient.
VAD_EAGERNESS=auto

PORT=3888
HOST=0.0.0.0

# Automatic visual tutoring after a pen pause.
AUTO_AI_DELAY_MS=1100

# Hard ceiling on upstream OpenAI calls per calendar day, as a cost guard.
DAILY_CALL_CAP=1500

# Session research logging. Logs are written under data/sessions/.
LOG_SESSIONS=1
LOG_STROKE_POINTS=1
