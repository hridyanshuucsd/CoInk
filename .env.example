# Prefer `coink-tutor configure` for an interactive setup. This file is a
# headless API example; copy only the values you need into ~/.coink/config.env.

# Visual planner: an OpenAI- or Anthropic-compatible endpoint.
AI_PROVIDER=api
AI_API_FORMAT=openai
AI_API_URL=https://api.openai.com/v1
AI_API_MODEL=gpt-5.6-terra
AI_API_KEY=sk-...
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=180

# Browser server and automatic tutoring delay.
HOST=0.0.0.0
PORT=3888
AUTO_AI_DELAY_SECONDS=5

# Realtime speech-to-speech. The selected official OpenAI planner key is reused
# automatically. Set a dedicated key only when the planner uses another source.
COINK_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_VAD_EAGERNESS=auto

# Raster image generation. It follows the same key-selection rule as voice.
COINK_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
